page = PAGE
page {
    10 = PAGEVIEW
    10 {
        paths {
            0 = EXT:cms_setup_kit/Resources/Private/PageView/
            10 = {$page.pageview.paths}
        }

        dataProcessing {
            # makes content elements available as {content} in Fluid template
            10 = page-content

            20 = files
            20 {
                references.fieldName = media
            }

            30 = menu
            30 {
                levels = 2
                includeSpacer = 1
                as = mainnavigation
            }
        }
    }

    headerData {
        1001 = FLUIDTEMPLATE
        1001.file = EXT:cms_setup_kit/Resources/Private/FluidTemplate/Partials/FavIcons.html

        1002 = FLUIDTEMPLATE
        1002.file = EXT:cms_setup_kit/Resources/Private/FluidTemplate/Partials/Meta.html
    }
}
